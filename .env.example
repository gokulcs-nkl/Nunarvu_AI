# ─── Django Settings ─────────────────────────────────
# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# ─── Database (default: SQLite — no setup needed) ────
# To use SQLite (default), leave DB_ENGINE unset or:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# To use PostgreSQL instead, set all of these:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=liveinlap
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# ─── Media and Static ────────────────────────────────
MEDIA_URL=/media/
STATIC_URL=/static/

# ─── Face recognition ────────────────────────────────
# Required before enrolling faces. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored face embedding unreadable.
FACE_EMBEDDING_KEY=
# Folder holding the InsightFace model files (default: backend/models/buffalo_l)
# FACE_MODEL_DIR=
# FACE_DETECTOR_FILE=det_10g.onnx
# FACE_RECOGNIZER_FILE=w600k_r50.onnx
# FACE_MATCH_CONFIRM=0.50
# FACE_MATCH_REVIEW=0.35
# ATTENDANCE_WINDOW_MINUTES=5
# ATTENDANCE_LATE_AFTER_MINUTES=10

# ─── Camera worker ───────────────────────────────────
# Required to run the camera worker. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=
# WORKER_WEB_URL=http://127.0.0.1:8000
# WORKER_ANALYSIS_FPS=5

*.pt
*.pth

# Environments
.env
.venv/
venv/
env/
project-env/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp

# Misc
*.swp
*.swo

# torch.hub download cache
backend/hub/

# Downloaded model files
backend/models/

# Machine-specific path to the Python interpreter used by start_nunarvu.bat
python_path.txt

# Local evaluation data and backups: never commit photos of people or database dumps
evaluation/
backups/
backend/backups/

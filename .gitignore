# Python / Django
__pycache__/
*.pyc
*.pyo
*.pyd

# SQLite database
*.sqlite3

# Static files (generated)
/backend/staticfiles/

# Media uploads (keep folder, ignore contents)
backend/media/students/*
!backend/media/students/.gitkeep

